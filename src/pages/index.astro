---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import ArticleCard from "../components/ArticleCard.astro";
import FeaturedArticle from "../components/FeaturedArticle.astro";
import profilePhoto from "../assets/profile.jpg";
import { PERSON, PERSON_ID, PROFILES, PROJECTS, SITE_URL, TALKS, WEBSITE_ID, personSchema } from "../data/site";
import { getArticles } from "../data/writing";

const [latest, ...rest] = await getArticles();
const recent = rest.slice(0, 3);
const featuredProjects = PROJECTS.slice(0, 3);

const schema = [
  personSchema(),
  {
    "@type": "WebSite",
    "@id": WEBSITE_ID,
    url: `${SITE_URL}/`,
    name: PERSON.name,
    description: `${PERSON.name} — ${PERSON.tagline}`,
    publisher: { "@id": PERSON_ID },
    inLanguage: "en-GB",
  },
];
---

<Base
  title="Ravi Shah — Executive Architect, IBM Consulting · Agentic Engineering"
  description="Ravi Shah is an Executive Architect at IBM Consulting UK&I in London, specialising in agentic engineering for Financial Services. Articles, open-source code and talks."
  path="/"
  schema={schema}
>
  <section class="wrap hero" aria-label="Introduction">
    <div class="hero-photo">
      <Picture
        src={profilePhoto}
        formats={["avif", "webp"]}
        widths={[240, 480]}
        sizes="(min-width: 40rem) 15rem, 9rem"
        alt="Portrait of Ravi Shah"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div>
      <h1 id="hero-name">Ravi Shah</h1>
      <p class="hero-role">Executive Architect · IBM Consulting UK&amp;I · London</p>
      <p class="hero-pitch">
        I build software with AI agents and ship agentic capability into production for Financial Services — and write about
        what works: agentic patterns, context engineering, token budgets and security.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`/writing/${latest.id}/`}>Read the latest article →</a>
        <a class="btn" href="/about/">About me</a>
      </div>
      <ul class="pill-links" aria-label="Profiles">
        {PROFILES.map((p) => <li><a href={p.url} rel="me" data-umami-event="Profile click" data-umami-event-profile={p.name} data-umami-event-from="home">{p.name}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="writing-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="writing-heading">Writing</h2>
        <a href="/writing/">All articles →</a>
      </div>
      <FeaturedArticle article={latest} />
      <ul class="post-list" style="margin-top:1.5rem">
        {recent.map((a) => <ArticleCard article={a} />)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="projects-heading">Open source</h2>
        <a href="/projects/">All projects →</a>
      </div>
      <ul class="card-grid">
        {
          featuredProjects.map((p) => (
            <li class="project-card">
              <h3><a href={p.url} data-umami-event="Repo click" data-umami-event-repo={p.name} data-umami-event-from="home">{p.name}</a></h3>
              <p>{p.description}</p>
              <ul class="tags" aria-label="Tags">
                {p.tags.map((t) => <li>{t}</li>)}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="speaking-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="speaking-heading">Speaking</h2>
        <a href="/speaking/">Invite me to speak →</a>
      </div>
      <ul class="talk-list">
        {
          TALKS.map((t) => (
            <li>
              <span class="year">{t.year}</span>
              <div>
                <strong>{t.title ?? t.event}</strong>
                {(t.title || t.topic) && <span> — {t.title ? t.event : t.topic}</span>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
