---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { PROJECTS, SITE_URL, WEBSITE_ID, personRef } from "../data/site";

const schema = {
  "@type": "CollectionPage",
  "@id": `${SITE_URL}/projects/#page`,
  name: "Projects — Ravi Shah",
  url: `${SITE_URL}/projects/`,
  description: "Open-source agentic engineering tools and Financial Services prototypes by Ravi Shah.",
  author: personRef,
  isPartOf: { "@id": WEBSITE_ID },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: PROJECTS.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: { "@type": "SoftwareSourceCode", name: p.name, description: p.description, codeRepository: p.url, author: personRef },
    })),
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Projects", item: `${SITE_URL}/projects/` },
    ],
  },
};
---

<Base
  title="Projects — Ravi Shah · Open-Source Agentic Engineering"
  description="Open-source projects by Ravi Shah: deep agent anatomy, Gitleaks repo scan agent, LLM token budget utilities, carbon accounting and Financial Services prototypes."
  path="/projects/"
  schema={schema}
>
  <PageHero title="Projects" sub="Open-source agents, security tools and Financial Services prototypes you can run and extend." />

  <div class="wrap">
    <ul class="card-grid">
      {
        PROJECTS.map((p) => (
          <li class="project-card">
            <h2><a href={p.url} data-umami-event="Repo click" data-umami-event-repo={p.name} data-umami-event-from="projects">{p.name}</a></h2>
            <p>{p.description}</p>
            <ul class="tags" aria-label="Tags">
              {p.tags.map((t) => <li>{t}</li>)}
            </ul>
            {p.article && <a class="card-link" href={`/writing/${p.article}/`}>Read the article →</a>}
          </li>
        ))
      }
    </ul>
    <p class="muted" style="margin-top:2rem">More on GitHub: <a href="https://github.com/shahravir?tab=repositories">github.com/shahravir</a></p>
  </div>
</Base>
