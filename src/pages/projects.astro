---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { PROJECTS, SITE_URL, WEBSITE_ID, personRef } from "../data/site";

const schema = {
  "@type": "CollectionPage",
  "@id": `${SITE_URL}/projects/#page`,
  name: "Projects — Ravi Shah",
  url: `${SITE_URL}/projects/`,
  description: "Open-source agentic engineering tools and Financial Services prototypes by Ravi Shah.",
  author: personRef,
  isPartOf: { "@id": WEBSITE_ID },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: PROJECTS.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "SoftwareSourceCode",
        name: p.name,
        description: p.description,
        codeRepository: p.url,
        author: personRef,
      },
    })),
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Projects", item: `${SITE_URL}/projects/` },
    ],
  },
};
---

<Base
  title="Projects — Ravi Shah · Open-Source Agentic Engineering"
  description="Open-source projects by Ravi Shah: deep agent anatomy, Gitleaks repo scan agent, LLM token budget utilities, carbon accounting and Financial Services prototypes."
  path="/projects/"
  schema={schema}
>
  <PageHero eyebrow="Projects" title="Open-source" strong="demos & tools" sub="Agents, security and Financial Services prototypes you can run and extend." />

  <main class="page-main">
    <div class="section-wrap">
      <section aria-labelledby="repos-heading">
        <h2 id="repos-heading">Repositories</h2>
        <ul class="card-grid card-grid--2">
          {
            PROJECTS.map((p) => (
              <li class="card">
                <h3><a href={p.url}>{p.name}</a></h3>
                <p>{p.description}</p>
                <p class="meta">
                  {p.tags.join(" · ")}
                  {p.article && (
                    <>
                      {" · "}
                      <a href={`/writing/${p.article}/`}>Article</a>
                    </>
                  )}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="more-heading">
        <h2 id="more-heading">More on GitHub</h2>
        <p class="lead">All repositories: <a href="https://github.com/shahravir?tab=repositories">github.com/shahravir</a></p>
      </section>
    </div>
  </main>
</Base>
