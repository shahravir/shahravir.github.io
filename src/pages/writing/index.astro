---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { SITE_URL, WEBSITE_ID, personRef } from "../../data/site";
import { getArticles } from "../../data/writing";

const articles = await getArticles();

const schema = {
  "@type": "CollectionPage",
  "@id": `${SITE_URL}/writing/#page`,
  name: "Writing — Ravi Shah",
  url: `${SITE_URL}/writing/`,
  description: "Articles by Ravi Shah on agentic engineering, context engineering, MCP and Financial Services.",
  author: personRef,
  isPartOf: { "@id": WEBSITE_ID },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: articles.map((a, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `${SITE_URL}/writing/${a.id}/`,
      name: a.data.title,
    })),
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Writing", item: `${SITE_URL}/writing/` },
    ],
  },
};
---

<Base
  title="Writing — Ravi Shah · Agentic Engineering, Context Engineering, MCP"
  description="All articles by Ravi Shah on agentic engineering, deep agents, context engineering, token budgets, MCP and shift-left security for Financial Services."
  path="/writing/"
  schema={schema}
>
  <PageHero
    eyebrow="Writing"
    title="Practical notes on"
    strong="agentic delivery"
    sub="Patterns, security and context engineering from building with agents in Financial Services."
  />

  <main class="page-main">
    <div class="section-wrap">
      <section aria-labelledby="articles-heading">
        <h2 id="articles-heading">All articles ({articles.length})</h2>
        <ul class="card-grid card-grid--2">
          {articles.map((a) => <ArticleCard article={a} />)}
        </ul>
      </section>

      <section aria-labelledby="channels-heading">
        <h2 id="channels-heading">Also published on</h2>
        <p class="lead">
          Articles appear here first and are syndicated to <a href="https://medium.com/@shah.ravir">Medium</a>,
          <a href="https://www.linkedin.com/in/ravishah01/recent-activity/articles/">LinkedIn</a> and
          <a href="https://dev.to/shahravir">DEV</a>. Subscribe via <a href="/feed.xml">RSS</a>.
        </p>
      </section>
    </div>
  </main>
</Base>
