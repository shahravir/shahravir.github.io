---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import FeaturedArticle from "../../components/FeaturedArticle.astro";
import { SITE_URL, WEBSITE_ID, personRef } from "../../data/site";
import { getArticles } from "../../data/writing";

const articles = await getArticles();
const [latest, ...older] = articles;
const byYear = Map.groupBy(older, (a) => a.data.pubDate.getFullYear());

const schema = {
  "@type": "CollectionPage",
  "@id": `${SITE_URL}/writing/#page`,
  name: "Writing — Ravi Shah",
  url: `${SITE_URL}/writing/`,
  description: "Articles by Ravi Shah on agentic engineering, context engineering, MCP and Financial Services.",
  author: personRef,
  isPartOf: { "@id": WEBSITE_ID },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: articles.map((a, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: `${SITE_URL}/writing/${a.id}/`,
      name: a.data.title,
    })),
  },
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "Writing", item: `${SITE_URL}/writing/` },
    ],
  },
};
---

<Base
  title="Writing — Ravi Shah · Agentic Engineering, Context Engineering, MCP"
  description="All articles by Ravi Shah on agentic engineering, deep agents, context engineering, token budgets, MCP and shift-left security for Financial Services."
  path="/writing/"
  schema={schema}
>
  <PageHero
    title="Writing"
    sub={`${articles.length} practical articles on building with AI agents — patterns, context engineering, token budgets and security.`}
  />

  <div class="wrap">
    <FeaturedArticle article={latest} headingLevel="h2" />

    {
      [...byYear.entries()].map(([year, posts]) => (
        <section aria-labelledby={`y${year}`}>
          <h2 class="year-heading" id={`y${year}`}>{year}</h2>
          <ul class="post-list">
            {posts.map((a) => <ArticleCard article={a} />)}
          </ul>
        </section>
      ))
    }

    <p class="muted" style="margin-top:2.5rem">
      Articles are published here first and syndicated to <a href="https://medium.com/@shah.ravir">Medium</a>,
      <a href="https://www.linkedin.com/in/ravishah01/recent-activity/articles/">LinkedIn</a> and
      <a href="https://dev.to/shahravir">DEV</a>. Subscribe via <a href="/feed.xml">RSS</a>.
    </p>
  </div>
</Base>
