---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import profilePhoto from "../assets/profile.jpg";
import { BIO, PERSON, PROFILES, PROJECTS, SITE_URL, TALKS, personSchema } from "../data/site";
import { getArticles } from "../data/writing";

const articles = await getArticles();
const topics = PERSON.knowsAbout.slice(0, 6).join(", ");

const faqs = [
  { q: "Who is Ravi Shah?", a: BIO.short },
  {
    q: "What does Ravi Shah write about?",
    a: `Agentic design patterns, context engineering, deep agents, token budget discipline (AI FinOps), the Model Context Protocol (MCP) in banking, and shift-left security. ${articles.length} articles are collected on ravishah.dev/writing.`,
  },
  { q: "Where has Ravi Shah spoken?", a: TALKS.map((t) => `${t.event} (${t.year})`).join("; ") + "." },
  {
    q: "How can I contact Ravi Shah?",
    a: "The quickest route is a LinkedIn message at linkedin.com/in/ravishah01. Speaking and writing invitations are welcome.",
  },
];

const schema = [
  {
    "@type": "ProfilePage",
    "@id": `${SITE_URL}/about/#page`,
    url: `${SITE_URL}/about/`,
    name: "About Ravi Shah",
    mainEntity: personSchema(),
    breadcrumb: {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
        { "@type": "ListItem", position: 2, name: "About", item: `${SITE_URL}/about/` },
      ],
    },
  },
];
---

<Base title="About Ravi Shah — Executive Architect, IBM Consulting UK&I" description={BIO.short} path="/about/" type="profile" schema={schema}>
  <div class="wrap stack-lg" style="padding-block: clamp(2.5rem, 6vw, 4rem)">
    <section class="about-intro" aria-labelledby="about-heading">
      <Picture
        src={profilePhoto}
        formats={["avif", "webp"]}
        widths={[240, 480]}
        sizes="(min-width: 40rem) 13rem, 10rem"
        alt="Portrait of Ravi Shah"
        loading="eager"
        fetchpriority="high"
      />
      <div class="stack">
        <h1 id="about-heading" style="font-size: var(--step-3)">About Ravi Shah</h1>
        <p class="lead muted">{PERSON.identity}</p>
        {BIO.long.map((p) => <p>{p}</p>)}
        <ul class="pill-links" aria-label="Profiles">
          {PROFILES.map((p) => <li><a href={p.url} rel="me" data-umami-event="Profile click" data-umami-event-profile={p.name} data-umami-event-from="about">{p.name}</a></li>)}
        </ul>
      </div>
    </section>

    <section aria-labelledby="facts-heading">
      <h2 id="facts-heading">At a glance</h2>
      <dl class="facts">
        <dt>Role</dt>
        <dd>{PERSON.jobTitle}, {PERSON.employer}</dd>
        <dt>Based in</dt>
        <dd>London, United Kingdom</dd>
        <dt>Focus</dt>
        <dd>{topics}</dd>
        <dt>Writing</dt>
        <dd><a href="/writing/">{articles.length} articles</a> — syndicated to Medium, LinkedIn and DEV</dd>
        <dt>Open source</dt>
        <dd>{PROJECTS.slice(0, 3).map((p, i) => <>{i > 0 && ", "}<a href={p.url} data-umami-event="Repo click" data-umami-event-repo={p.name} data-umami-event-from="about">{p.name}</a></>)} and <a href="/projects/">more</a></dd>
        <dt>Speaking</dt>
        <dd><a href="/speaking/">{TALKS.map((t) => `${t.event} (${t.year})`).join(" · ")}</a></dd>
      </dl>
    </section>

    <section aria-labelledby="recent-heading">
      <h2 id="recent-heading">Selected writing</h2>
      <ul class="stack" style="padding-left:1.2rem">
        {articles.slice(0, 5).map((a) => <li><a href={`/writing/${a.id}/`}>{a.data.title}</a></li>)}
      </ul>
    </section>

    <section aria-labelledby="press-heading">
      <h2 id="press-heading">Press kit</h2>
      <p class="muted" style="margin-bottom:1rem">For event organisers and editors — please use these as-is and link to ravishah.dev.</p>
      <div class="card-grid">
        <div class="panel">
          <h3>Short bio</h3>
          <p>{BIO.short}</p>
        </div>
        <div class="panel">
          <h3>Headshot &amp; one-liner</h3>
          <p><a href="/images/profile.jpg" download>Download headshot (800 × 800 JPG)</a></p>
          <p style="margin-top:0.5rem">{PERSON.name} — {PERSON.identity}</p>
        </div>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">Frequently asked</h2>
      {
        faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </section>
  </div>
</Base>
