---
import { formatDate, readingMinutes, type Article } from "../data/writing";

interface Props {
  article: Article;
  headingLevel?: "h2" | "h3";
}

const { article, headingLevel = "h3" } = Astro.props;
const { title, description, pubDate } = article.data;
const Heading = headingLevel;
---

<li>
  <time datetime={pubDate.toISOString()}>{formatDate(pubDate, "short")}</time>
  <div>
    <Heading><a href={`/writing/${article.id}/`}>{title}</a></Heading>
    <p>{description}</p>
    <p class="meta">{readingMinutes(article)} min read</p>
  </div>
</li>
