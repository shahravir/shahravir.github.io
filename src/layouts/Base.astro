---
import { NAV, OG_IMAGE, PERSON, PROFILES, SITE_URL } from "../data/site";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: "website" | "article" | "profile";
  schema?: object | object[];
  publishedTime?: Date;
  modifiedTime?: Date;
}

const { title, description, path, image, type = "website", schema, publishedTime, modifiedTime } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const ogImage = image ? new URL(image, SITE_URL).href : OG_IMAGE;
const current = Astro.url.pathname;
const jsonLd = schema && { "@context": "https://schema.org", "@graph": Array.isArray(schema) ? schema : [schema] };
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={PERSON.name} />
    <meta name="google-site-verification" content="-frLiZ4ZJ7DgPl2wT0SrLb-9Z2n6ieLbzWFyfeug89Q" />
    <meta name="theme-color" content="#161616" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${PERSON.name} — Writing`} href="/feed.xml" />
    {PROFILES.map((p) => <link rel="me" href={p.url} />)}

    <meta property="og:site_name" content={PERSON.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_GB" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === "article" && <meta property="article:author" content={`${SITE_URL}/about/`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <nav class="nav" aria-label="Site">
      <a href="/" class="nav-logo">
        <span class="monogram" aria-hidden="true">RS</span>
        <span class="nav-brand">Ravi Shah<strong>{PERSON.tagline}</strong></span>
      </a>
      <ul class="nav-links">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={current.startsWith(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="nav-cta" href="https://www.linkedin.com/in/ravishah01/">Connect ↗</a>
    </nav>

    <slot />

    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>
          <a href="/">Home</a> · <a href="/about/">About</a> · <a href="/writing/">Writing</a> ·
          <a href="/projects/">Projects</a> · <a href="/speaking/">Speaking</a> · <a href="/now/">Now</a> ·
          <a href="/feed.xml">RSS</a>
        </p>
        <p>
          {
            PROFILES.map((p, i) => (
              <>
                {i > 0 && " · "}
                <a href={p.url} rel="me">
                  {p.name}
                </a>
              </>
            ))
          }
        </p>
        <p class="footer-note">© {new Date().getFullYear()} Ravi Shah, London. Personal site — views are my own and do not represent IBM.</p>
      </div>
    </footer>

    <script is:inline src="/hero.js" defer></script>
    <script is:inline src="/hub.js" defer></script>
  </body>
</html>
