---
import "@fontsource-variable/inter";
import "../styles/global.css";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import profilePhoto from "../assets/profile.jpg";
import { NAV, OG_IMAGE, PERSON, PROFILES, SITE_URL } from "../data/site";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: ImageMetadata;
  type?: "website" | "article" | "profile";
  schema?: object | object[];
  publishedTime?: Date;
  modifiedTime?: Date;
}

const { title, description, path, image, type = "website", schema, publishedTime, modifiedTime } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const ogImage = image ? new URL((await getImage({ src: image, width: 1200, format: "jpg", quality: 82 })).src, SITE_URL).href : OG_IMAGE;
const avatar = await getImage({ src: profilePhoto, width: 64, height: 64, format: "webp" });
const current = Astro.url.pathname;
const jsonLd = schema && { "@context": "https://schema.org", "@graph": Array.isArray(schema) ? schema : [schema] };
const speculation = { prerender: [{ where: { href_matches: "/*" }, eagerness: "moderate" }] };
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={PERSON.name} />
    <meta name="google-site-verification" content="-frLiZ4ZJ7DgPl2wT0SrLb-9Z2n6ieLbzWFyfeug89Q" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e1116" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${PERSON.name} — Writing`} href="/feed.xml" />
    {PROFILES.map((p) => <link rel="me" href={p.url} />)}

    <meta property="og:site_name" content={PERSON.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_GB" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {type === "article" && <meta property="article:author" content={`${SITE_URL}/about/`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Apply a saved theme choice before first paint so there is no flash. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        var system = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        root.dataset.theme = stored === "light" || stored === "dark" ? stored : system;
      })();
    </script>
    <!-- Prerender same-site pages on hover/press for near-instant navigation (Speculation Rules API). -->
    <script is:inline type="speculationrules" set:html={JSON.stringify(speculation)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a href="/" class="brand" aria-label="Ravi Shah — home">
          <img src={avatar.src} alt="" width="32" height="32" />
          <span>Ravi Shah</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={current.startsWith(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <button class="theme-toggle" type="button" aria-label="Switch colour theme" hidden>
            <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
            <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <section aria-labelledby="footer-about">
            <h2 id="footer-about">Ravi Shah</h2>
            <p>{PERSON.identity}.</p>
            <p style="margin-top:0.75rem"><a href="https://www.linkedin.com/in/ravishah01/">Connect on LinkedIn →</a></p>
          </section>
          <nav aria-labelledby="footer-explore">
            <h2 id="footer-explore">Explore</h2>
            <ul>
              <li><a href="/writing/">Writing</a></li>
              <li><a href="/projects/">Projects</a></li>
              <li><a href="/speaking/">Speaking</a></li>
              <li><a href="/about/">About &amp; press kit</a></li>
              <li><a href="/now/">Now</a></li>
            </ul>
          </nav>
          <section aria-labelledby="footer-elsewhere">
            <h2 id="footer-elsewhere">Elsewhere</h2>
            <ul>
              {PROFILES.map((p) => <li><a href={p.url} rel="me">{p.name}</a></li>)}
              <li><a href="/feed.xml">RSS feed</a></li>
            </ul>
          </section>
        </div>
        <p class="footer-note">© {new Date().getFullYear()} Ravi Shah · London. Personal site — views are my own and do not represent IBM.</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.querySelector(".theme-toggle");
        if (!btn) return;
        function label() {
          btn.setAttribute("aria-label", root.dataset.theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
        }
        btn.hidden = false;
        label();
        btn.addEventListener("click", function () {
          root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
          try {
            localStorage.setItem("theme", root.dataset.theme);
          } catch (e) {}
          label();
        });
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", function (e) {
          var stored = null;
          try {
            stored = localStorage.getItem("theme");
          } catch (err) {}
          if (!stored) {
            root.dataset.theme = e.matches ? "dark" : "light";
            label();
          }
        });
      })();
    </script>
  </body>
</html>
